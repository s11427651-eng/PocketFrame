# PocketFrame environment variables
# All optional — the app runs fully in-browser (localStorage) without these.
# Add them when you wire the backend to Supabase + R2/S3.

# Supabase (Auth + Postgres metadata)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloud object storage — photos/videos (25 GB free, no credit card) via Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD=
NEXT_PUBLIC_CLOUDINARY_PRESET=
# Alternative: Cloudflare R2 (10 GB free, needs card for activation)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Optional: Mapbox for map tiles (falls back to OpenStreetMap)
NEXT_PUBLIC_MAPBOX_TOKEN=
