# PocketFrame environment variables
# All optional — the app runs fully in-browser (localStorage) without these.
# Add them when you wire the backend to Supabase + R2/S3.

# Supabase (Auth + Postgres metadata)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloud object storage (Cloudflare R2) — original photos/videos (10 GB free)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=
# ^ the bucket's public URL, e.g. https://xxx.r2.dev

# Optional: Mapbox for map tiles (falls back to OpenStreetMap)
NEXT_PUBLIC_MAPBOX_TOKEN=
